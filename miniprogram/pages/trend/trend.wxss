.offline-bar {
  margin: 0 28rpx 20rpx;
  background: #fdf0dc;
  color: #8a4106;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.seg {
  display: flex;
  background: #e4e8ee;
  border-radius: 28rpx;
  padding: 8rpx;
  margin-bottom: 28rpx;
}
.seg-btn {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  padding: 24rpx 0;
  border-radius: 22rpx;
  color: #49505e;
}
.seg-btn.on {
  background: #ffffff;
  color: #191d23;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.trend-canvas {
  width: 100%;
  height: 500rpx;
}
.detail {
  font-size: 32rpx;
  color: #49505e;
  text-align: center;
  min-height: 48rpx;
  margin-top: 14rpx;
  line-height: 1.6;
}

/* 统计卡 */
.stat-grid {
  display: flex;
  gap: 20rpx;
}
.stat {
  flex: 1;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(30, 40, 60, 0.06);
}
.sv {
  font-size: 54rpx;
  font-weight: 700;
}
.sv .v2 {
  font-size: 36rpx;
}
.sv .su {
  font-size: 28rpx;
  font-weight: 500;
  color: #49505e;
}
.sl {
  font-size: 30rpx;
  color: #49505e;
  margin-top: 8rpx;
}
.stat-sub {
  font-size: 32rpx;
  color: #49505e;
  text-align: center;
  margin: 24rpx 8rpx;
  line-height: 1.6;
}

/* 时段均值 */
.pa-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f2f5;
  min-height: 128rpx;
}
.pa-row:last-of-type { border-bottom: none; }
.pl {
  width: 156rpx;
  font-size: 34rpx;
  font-weight: 700;
  flex: none;
}
.bar-wrap {
  flex: 1;
  height: 28rpx;
  background: #eceff3;
  border-radius: 14rpx;
  overflow: hidden;
}
.bar {
  height: 100%;
  border-radius: 14rpx;
}
.pv {
  width: 220rpx;
  text-align: right;
  font-size: 30rpx;
  color: #49505e;
  flex: none;
}
.pv-b {
  font-size: 40rpx;
  color: #191d23;
  font-weight: 700;
}
.pa-note { margin-top: 20rpx; line-height: 1.7; }

/* 历史 */
.his-group {
  font-size: 32rpx;
  color: #49505e;
  font-weight: 700;
  margin: 22rpx 4rpx 4rpx;
}
.rec-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 4rpx;
  border-bottom: 2rpx solid #f0f2f5;
  min-height: 152rpx;
}
.rec-row:last-child { border-bottom: none; }
.dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex: none;
}
.bg-ok { background: #0e9c73; }
.bg-low { background: #b45309; }
.bg-high { background: #c53030; }
.rt { flex: 1; }
.rp { font-size: 36rpx; font-weight: 700; }
.note-inline { font-weight: 400; font-size: 32rpx; }
.rtime { font-size: 32rpx; color: #49505e; margin-top: 6rpx; }
.rv { font-size: 56rpx; font-weight: 700; }
.fold-more {
  width: 100%;
  text-align: center;
  background: #e3efe9;
  color: #0b7d5e;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 28rpx;
  padding: 26rpx 0;
  margin-top: 24rpx;
}
