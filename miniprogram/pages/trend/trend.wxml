<view class="offline-bar" wx:if="{{offline}}">当前离线：数据已保存在本机，联网后自动同步</view>

<view class="seg">
  <view class="seg-btn {{days === 7 ? 'on' : ''}}" data-days="7" bindtap="onSeg">近7天</view>
  <view class="seg-btn {{days === 30 ? 'on' : ''}}" data-days="30" bindtap="onSeg">近30天</view>
  <view class="seg-btn {{days === 90 ? 'on' : ''}}" data-days="90" bindtap="onSeg">近90天</view>
</view>

<view class="card">
  <view class="card-title">
    <text>血糖趋势</text>
    <text class="muted">{{chartSub}}</text>
  </view>
  <block wx:if="{{hasChart}}">
    <canvas id="trend-canvas" type="2d" class="trend-canvas" bindtap="onChartTap"></canvas>
    <view class="detail">{{detailText}}</view>
  </block>
  <view class="empty" wx:else>
    <view>这段时间还没有记录</view>
  </view>
</view>

<block wx:if="{{statCards.length}}">
  <view class="stat-grid">
    <view class="stat" wx:for="{{statCards}}" wx:key="l">
      <view class="sv">{{item.v}}<text class="v2" wx:if="{{item.v2}}">{{item.v2}}</text><text class="su" wx:if="{{item.u}}">{{item.u}}</text></view>
      <view class="sl">{{item.l}}</view>
    </view>
  </view>
  <view class="stat-sub">{{statSub}}</view>

  <view class="card">
    <view class="card-title">
      <text>各时段平均</text>
    </view>
    <view class="pa-row" wx:for="{{paRows}}" wx:key="label">
      <view class="pl">{{item.label}}</view>
      <view class="bar-wrap" wx:if="{{!item.empty}}">
        <view class="bar" style="width:{{item.pct}}%;background:{{item.color}}"></view>
      </view>
      <view class="bar-wrap" wx:else></view>
      <view class="pv" wx:if="{{!item.empty}}"><text class="pv-b">{{item.avgText}}</text> {{item.countText}}</view>
      <view class="pv muted" wx:else>{{item.countText}}</view>
    </view>
    <view class="muted pa-note">「空腹」按空腹目标判断，其余按非空腹目标判断</view>
  </view>

  <view class="card">
    <view class="card-title">
      <text>历史记录</text>
    </view>
    <block wx:if="{{hasHistory}}">
      <view wx:for="{{historyGroups}}" wx:key="label" wx:for-item="g">
        <view class="his-group">{{g.label}}</view>
        <view class="rec-row" wx:for="{{g.rows}}" wx:key="id" bindtap="tapRecord" data-id="{{item.id}}">
          <view class="dot bg-{{item.cls}}"></view>
          <view class="rt">
            <view class="rp">
              {{item.periodLabel}}
              <text class="muted note-inline" wx:if="{{item.note}}">· {{item.note}}</text>
            </view>
            <view class="rtime">{{item.timeText}}</view>
          </view>
          <view class="rv" style="color:{{item.color}}">{{item.value}}</view>
        </view>
      </view>
      <view class="fold-more" wx:if="{{canExpand}}" bindtap="onExpand">{{expandText}}</view>
    </block>
    <view class="empty" wx:else>
      <view>还没有记录</view>
    </view>
  </view>
</block>
<view class="card" wx:else>
  <view class="empty">
    <view>这段时间还没有记录</view>
    <view>回「今天」页点 ＋ 记一笔</view>
  </view>
</view>
