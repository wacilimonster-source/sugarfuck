.offline-bar {
  margin: 0 28rpx 20rpx;
  background: #fdf0dc;
  color: #8a4106;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.today-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 6rpx 20rpx;
}
.date {
  font-size: 46rpx;
  font-weight: 700;
}
.streak {
  background: #fff3e0;
  color: #8a4106;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 28rpx;
  padding: 14rpx 26rpx;
}

/* 提醒卡 */
.remind {
  border-radius: 36rpx;
  padding: 30rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #fff4e2, #fdefd8);
  border: 4rpx solid #f0dcbb;
}
.remind.ok {
  background: #dff4ea;
  border-color: #bfe5d4;
}
.ricon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #f7dca6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex: none;
}
.remind.ok .ricon { background: #b8e9d2; }
.rbody { flex: 1; }
.rt {
  font-size: 38rpx;
  font-weight: 700;
  color: #6d4d0f;
}
.remind.ok .rt { color: #0a5c44; }
.rd {
  font-size: 32rpx;
  color: #8a6d33;
  margin-top: 6rpx;
  line-height: 1.6;
}
.remind.ok .rd { color: #3c7a63; }

/* 最近一次大卡 */
.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.htime {
  font-size: 32rpx;
  color: #49505e;
}
.period-chip {
  font-size: 32rpx;
  font-weight: 700;
  color: #085c45;
  background: #dff4ea;
  border-radius: 24rpx;
  padding: 12rpx 28rpx;
}
.hero-val {
  font-size: 144rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -2rpx;
  margin-top: 8rpx;
}
.hero-val .unit {
  font-size: 38rpx;
  font-weight: 500;
  color: #49505e;
  margin-left: 12rpx;
}
.c-low { color: #b45309; }
.c-high { color: #c53030; }
.status-tag {
  display: inline-flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: 700;
  border-radius: 24rpx;
  padding: 14rpx 28rpx;
  margin-top: 20rpx;
}
.st-ok { color: #0a5c44; background: #dff4ea; }
.st-low { color: #8a4106; background: #fdf0dc; }
.st-high { color: #a02020; background: #fdeaea; }
.hero-note { margin-top: 20rpx; }

/* 记录行 */
.rec-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 4rpx;
  border-bottom: 2rpx solid #f0f2f5;
  min-height: 152rpx;
}
.rec-row:last-child { border-bottom: none; }
.dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex: none;
}
.bg-ok { background: #0e9c73; }
.bg-low { background: #b45309; }
.bg-high { background: #c53030; }
.rt { flex: 1; }
.rp {
  font-size: 36rpx;
  font-weight: 700;
}
.note-inline {
  font-weight: 400;
  font-size: 32rpx;
}
.rtime {
  font-size: 32rpx;
  color: #49505e;
  margin-top: 6rpx;
}
.rv {
  font-size: 56rpx;
  font-weight: 700;
}

/* 迷你趋势 */
.spark {
  width: 100%;
  height: 168rpx;
}
.cap { margin-top: 12rpx; }
.more {
  font-size: 32rpx;
  color: #0b7d5e;
  font-weight: 600;
}
